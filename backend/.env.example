# 后端数据库配置示例：复制为同目录的 .env，再填写自己创建容器时的密码。
# backend/.env 被 Git 忽略；不要覆盖项目根目录中已有的学习脚本配置。
# PostgreSQL 容器的 POSTGRES_PASSWORD 必须与下面的密码一致。
# 连接格式：postgresql+psycopg://用户名:密码@主机:端口/数据库名
# 若密码含 @、:、/、% 等 URL 特殊字符，需要先进行 URL 编码。
TRAVELMIND_DATABASE_URL=postgresql+psycopg://travelmind:REPLACE_WITH_YOUR_PASSWORD@127.0.0.1:5432/travelmind

# 配置文件不会自动读取，检查命令通过 --env-file .env 显式指定它。
# 操作系统中同名环境变量优先于文件；SecretStr 脱敏不能替代对文件的保管。

# M2单模型需求抽取。密钥留空不影响已有预算服务，抽取命令会提示模型未配置。
# 也兼容学习配置中的DS_API_KEY；使用哪份文件，由--env-file明确指定。
TRAVELMIND_DEEPSEEK_API_KEY=
TRAVELMIND_DEEPSEEK_MODEL=deepseek-v4-pro
TRAVELMIND_DEEPSEEK_TIMEOUT_SECONDS=30

# M3原文件目录：不填时使用backend/data/uploads；需要调整时建议填写绝对路径。
# 仅改保存位置，不开启模型读取、OCR或向量索引；原文目录不得提交到Git。
# TRAVELMIND_DOCUMENT_UPLOAD_DIR=E:/TravelMindAI/backend/data/uploads
# M3向量服务：以下为阿里云百炼text-embedding-v4示例
TRAVELMIND_EMBEDDING_PROVIDER=aliyun
TRAVELMIND_EMBEDDING_BASE_URL=https://ws-19x4uyg6j1ouw0hr.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
TRAVELMIND_EMBEDDING_MODEL=text-embedding-v4
TRAVELMIND_EMBEDDING_API_KEY=
TRAVELMIND_EMBEDDING_DIMENSIONS=1024
# TRAVELMIND_EMBEDDING_VERSION=aliyun-text-embedding-v4-1024-v1
TRAVELMIND_EMBEDDING_TIMEOUT_SECONDS=30

# M3本机Milvus：先在项目根目录运行docker compose -f deploy/milvus/compose.yaml up -d。
# 取消注释并重启后端才启用；Web索引与搜索使用上面独立的Embedding配置。
# TRAVELMIND_MILVUS_URL=http://127.0.0.1:19530
# TRAVELMIND_MILVUS_TIMEOUT_SECONDS=30

# 高德开放平台创建“Web服务”类型Key后填写；不是前端JS API Key。
# 地图消费金额仅作人均消费参考，不能据此确认门票或免费。
TRAVELMIND_AMAP_API_KEY=

# 网页搜索独立Key：未填写时保留知识库回答，明确提示尚未联网核验。
TRAVELMIND_TAVILY_API_KEY=
# JSON数组：可加入经过核实的景区官网域名；默认只搜索政府公开网站。
TRAVELMIND_TRAVEL_WEB_DOMAINS='["gov.cn"]'
